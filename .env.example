# ─────────────────────────────────────────────────────────────────────────────
# MyKpopTrade — API. Copier en `.env` et renseigner les valeurs.
# Le schéma de référence est src/config/env.ts : l'API refuse de démarrer si la
# configuration est invalide.
# ─────────────────────────────────────────────────────────────────────────────

# ── Général ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# Origines CORS additionnelles, séparées par des virgules (FRONTEND_URL est
# toujours autorisée). Ex. : https://mykpoptrade.com,https://www.mykpoptrade.com
CORS_ORIGINS=

# Nombre de reverse proxies devant l'API. 0 en local, 1 derrière un seul nginx /
# Render / Heroku. Nécessaire pour que le rate limiting par IP cible le vrai client.
# ⚠️ Ne pas surévaluer : X-Forwarded-For deviendrait falsifiable.
TRUST_PROXY=0

# Taille maximale d'un corps de requête JSON / urlencoded.
BODY_LIMIT=1mb

# ── Base de données ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mykpoptrade

# ── JWT ──────────────────────────────────────────────────────────────────────
# 32 caractères minimum. OBLIGATOIRE en production (une valeur par défaut y est
# refusée au démarrage). Générer avec : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
FROM_EMAIL=noreply@mykpoptrade.com

# ── Alertes d'administration ─────────────────────────────────────────────────
# Webhook Discord recevant les alertes de modération (signalement, litige,
# vérification d'identité, demande RGPD) et les incidents de paiement.
# Salon Discord > Paramètres > Intégrations > Webhooks > Copier l'URL.
# Variable absente = canal Discord inactif, les admins gardent la notification
# in-app. Ce n'est pas une erreur de démarrage.
ADMIN_DISCORD_WEBHOOK_URL=

# ── Analyse IA des annonces (Mistral, avec secours Gemini) ───────────────────
# Modère les annonces contenant un mot suspect (contrefaçon, objet interdit,
# contournement de paiement...) : mise en pause automatique + alerte Discord
# si confirmé. Mistral est utilisé en premier ; en cas d'échec (le tier
# gratuit "La Plateforme" est best-effort et peut rejeter des requêtes sans
# prévenir), Gemini prend le relais automatiquement si sa clé est renseignée.
# Variables absentes = fonctionnalité inactive, aucune erreur de démarrage.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── SMS (vérification téléphonique, Twilio) ──────────────────────────────────
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Authentification sociale ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── PayPal (OBLIGATOIRE en production) ───────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Marketplace ──────────────────────────────────────────────────────────────
# URL publique et email de support, pré-remplis sur les comptes vendeurs
# connectés lors de l'onboarding PayPal.
MARKETPLACE_URL=https://mykpoptrade.com
SUPPORT_EMAIL=support@mykpoptrade.com

# ── Chiffrement (OBLIGATOIRES en production) ─────────────────────────────────
# 32 caractères minimum chacune. Générer avec : openssl rand -hex 32

# Chiffrement des messages de la messagerie.
MESSAGE_ENCRYPTION_KEY=

# Chiffrement des données personnelles : anonymisation RGPD des paiements de
# plus de 3 ans, documents d'identité.
ENCRYPTION_KEY=

# ⚠️ HISTORIQUE — ne renseigner que si la base contient des données chiffrées
# avant septembre 2026. Le chiffrement tire désormais un IV aléatoire par
# opération ; cette variable ne sert plus qu'à relire l'ancien format.
# ENCRYPTION_IV=

# ── Logs ─────────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
